# Amazonite Store — secrets are NOT committed to Git.
# Add these values to the runtime environment / GitHub Actions secrets / n8n credentials.

GEMINI_API_KEY=
GROQ_API_KEY=
CLARITY_PROJECT_ID=

# Owner authentication — generate a strong random secret and a scrypt password hash.
# Never put the real values in this file or in frontend code.
AMAZONITE_AUTH_SECRET=
AMAZONITE_OWNER_PASSWORD_HASH=

# Affiliate / product source
ALIEXPRESS_AFFILIATE_ID=
ALIEXPRESS_AFFILIATE_TRACKING_ID=

# Product persistence: keep "json" for safe local/static fallback; use "google_sheets"
# only after the spreadsheet and service-account credentials are configured.
PRODUCT_STORAGE_PROVIDER=json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Products
GOOGLE_SERVICE_ACCOUNT_JSON=

# Shared server-side analytics. Requires an "Events" tab (or the configured tab)
# with columns: timestamp, type, product_id, offer_id, page, destination_domain.
ANALYTICS_STORAGE_PROVIDER=json
GOOGLE_SHEETS_ANALYTICS_TAB=Events

# AliExpress product source
ALIEXPRESS_SOURCE_MODE=auto
ALIEXPRESS_SCRAPER_API_BASE=https://aliexpress-scraper-api.omkar.cloud
ALIEXPRESS_SCRAPER_API_KEY=
AE_COUNTRY_CODE=US
AE_REGION=US
AE_CURRENCY=USD
AE_LOCALE=en_US

# Protected Vercel server-side proxy for live product research.
# Keep this secret server-side; never prefix it with NEXT_PUBLIC_.
AMAZONITE_INTERNAL_API_TOKEN=

# MCP — local/self-hosted AliExpress adapter (optional legacy endpoint)
ALIEXPRESS_MCP_URL=http://127.0.0.1:8000/mcp
SHOPME_API_BASE=https://api.shopmeagent.com

# Publishing target (fill only if the platform exposes an API)
STORE_PUBLISH_URL=
STORE_PUBLISH_TOKEN=

# Content policy / hard product gates
MIN_ORDERS=500
MIN_RATING=4.5
MIN_COMMISSION_PERCENT=8
